clc;
clear;
close all;

data = [1 0 0 1 1 0 1];
N = length(data);

bit_rate = 1;
f1 = 10;
f2 = 5;
Fs = 1000;

Tb = 1 / bit_rate;
t_bit = 0:1/Fs:Tb-1/Fs;

input_msg = [];
bfsk_sig = [];
demod_bits = zeros(1,N);

for i = 1:N
    bit = data(i);

    msg_bit = bit * ones(1,length(t_bit));

    if bit == 1
        freq = f1;
    else
        freq = f2;
    end

    carrier = cos(2*pi*freq*t_bit);

    input_msg = [input_msg msg_bit];
    bfsk_sig = [bfsk_sig carrier];
end

T = 0:1/Fs:(N*Tb)-1/Fs;

for i = 1:N
    segment = bfsk_sig((i-1)*length(t_bit)+1:i*length(t_bit));

    ref1 = cos(2*pi*f1*t_bit);
    ref2 = cos(2*pi*f2*t_bit);

    corr1 = trapz(t_bit,segment.*ref1);
    corr2 = trapz(t_bit,segment.*ref2);

    demod_bits(i) = corr1 > corr2;
end

demod_msg = [];

for i = 1:N
    demod_msg = [demod_msg demod_bits(i)*ones(1,length(t_bit))];
end

figure;

subplot(4,1,1);
plot(T,input_msg,'k','LineWidth',2);
ylim([-0.5 1.5]);
xlabel('Time (seconds)');
ylabel('Amplitude');
title('Input Bit Stream');
grid on;

subplot(4,1,2);
plot(T,cos(2*pi*f1*T),'g');
xlabel('Time (seconds)');
ylabel('Amplitude');
title('Carrier Signal (High Frequency for bit 1)');
grid on;

subplot(4,1,3);
plot(T,cos(2*pi*f2*T),'b');
xlabel('Time (seconds)');
ylabel('Amplitude');
title('Carrier Signal (Low Frequency for bit 0)');
grid on;

subplot(4,1,4);
plot(T,bfsk_sig,'m');
xlabel('Time (seconds)');
ylabel('Amplitude');
title('BFSK Modulated Signal');
grid on;

disp('Original Data:');
disp(data);

disp('Demodulated Data:');
disp(demod_bits);
