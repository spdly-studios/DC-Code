clc; clear; close all;

d = randi([0 1],1,10);
b = 2*d-1;
s = 8;

t = upsample(b,s);
p = ones(1,s);
x = conv(t,p);

SNR = 10;
r = x + sqrt(mean(x.^2)/10^(SNR/10))*randn(size(x));

m = conv(r,fliplr(p));
o = s;
q = m(o:s:end);
z = q > 0;

disp('Original bits:');
disp(d);
disp('Recovered bits:');
disp(z(1:length(d)));

figure;
subplot(3,1,1);
stem(d);
title('Original Data');

subplot(3,1,2);
plot(r);
title('Received Signal');

subplot(3,1,3);
plot(m);
hold on;
stem(o:s:length(m),q,'r');
title('Matched Filter Output');
