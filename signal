clc;
clear;

Fs = 100;
t = (0:Fs-1)/Fs;

% Generate two signals
signal_a = sin(2*pi*5*t);
signal_b = sin(2*pi*5*t + pi/4) + 0.5*cos(2*pi*10*t);

% Gram-Schmidt Orthogonalization

% First signal
u1 = signal_a;
e1 = u1 / norm(u1);

% Second signal
u2 = signal_b - dot(signal_b,e1)*e1;
e2 = u2 / norm(u2);

% Check orthogonality
dot_product = dot(e1,e2);

fprintf('Dot product of orthogonalized signals: %f\n',dot_product);

% Plot
figure;

subplot(2,1,1);
plot(t,signal_a,'b',t,signal_b,'r--');
title('Original Non-Orthogonal Signals');
legend('Signal A','Signal B');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;

subplot(2,1,2);
plot(t,e1,'b',t,e2,'r--');
title('Gram-Schmidt Orthogonalized Signals');
legend('Orthogonal Signal 1','Orthogonal Signal 2');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;
