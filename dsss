clc; clear; close all;

d = [1 0 1 1 0];
p = [1 0 1 0 1 1 0];

b = 2*d-1;
p = 2*p-1;
n = length(p);

x = [];
for i = 1:length(b)
    x = [x b(i)*p];
end

SNR = 5;
r = x + sqrt(mean(x.^2)/10^(SNR/10))*randn(size(x));

z = zeros(1,length(d));
for i = 1:length(d)
    z(i) = sum(r((i-1)*n+1:i*n).*p) > 0;
end

disp('Original Data Bits:');
disp(d);

disp('Recovered Data Bits:');
disp(z);

figure;
subplot(3,1,1);
stem(d,'filled');
title('Original Data Bits');
ylim([-.5 1.5]);

subplot(3,1,2);
plot(x);
title('Spread Signal');

subplot(3,1,3);
stem(z,'filled');
title('Recovered Data Bits');
ylim([-.5 1.5]);
