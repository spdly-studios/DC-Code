clc;
clear;
close all;

t = 0:0.001:1;

s1 = sin(2*pi*5*t);
s2 = square(2*pi*5*t);
s3 = sawtooth(2*pi*5*t);

tdm_signal = zeros(1,length(t)*3);

tdm_signal(1:3:end) = s1;
tdm_signal(2:3:end) = s2;
tdm_signal(3:3:end) = s3;

rec_s1 = tdm_signal(1:3:end);
rec_s2 = tdm_signal(2:3:end);
rec_s3 = tdm_signal(3:3:end);

t_rec = 0:0.001:(length(rec_s1)-1)*0.001;

figure;

subplot(4,1,1);
plot(t,s1);
title('Original Signal 1 (Sine)');

subplot(4,1,2);
plot(t,s2);
title('Original Signal 2 (Square)');

subplot(4,1,3);
plot(t,s3);
title('Original Signal 3 (Sawtooth)');

subplot(4,1,4);
plot(t_rec,rec_s1,'r',t_rec,rec_s2,'g',t_rec,rec_s3,'b');
title('Recovered Signals from TDM');
legend('Signal 1','Signal 2','Signal 3');
