clc;
clear;
close all;

data = [1 0 1 1 0 1 0];
N = length(data);

bit_rate = 1;
fc = 10;
Fs = 1000;

Tb = 1 / bit_rate;
t_bit = 0:1/Fs:Tb-1/Fs;

input_msg = [];
carrier_sig = [];
bpsk_sig = [];
demod_bits = zeros(1, N);

for i = 1:N
    bit = data(i);

    msg_bit = bit * ones(1, length(t_bit));

    carrier = cos(2*pi*fc*t_bit);

    modulated = (2*bit - 1) * carrier;

    input_msg = [input_msg msg_bit];
    carrier_sig = [carrier_sig carrier];
    bpsk_sig = [bpsk_sig modulated];
end

T = 0:1/Fs:(N*Tb)-1/Fs;

for i = 1:N
    segment = bpsk_sig((i-1)*length(t_bit)+1:i*length(t_bit));

    reference = cos(2*pi*fc*t_bit);

    product = segment .* reference;

    integrator_output = trapz(t_bit, product);

    if integrator_output >= 0
        demod_bits(i) = 1;
    else
        demod_bits(i) = 0;
    end
end

demod_msg = [];

for i = 1:N
    demod_msg = [demod_msg demod_bits(i)*ones(1,length(t_bit))];
end

figure;

subplot(4,1,1);
plot(T, input_msg, 'k', 'LineWidth', 2);
ylim([-0.5 1.5]);
xlabel('Time (seconds)');
ylabel('Amplitude');
title('Input Bit Stream');
grid on;

subplot(4,1,2);
plot(T, carrier_sig, 'b');
xlabel('Time (seconds)');
ylabel('Amplitude');
title('Carrier Signal');
grid on;

subplot(4,1,3);
plot(T, bpsk_sig, 'r');
xlabel('Time (seconds)');
ylabel('Amplitude');
title('BPSK Modulated Signal');
grid on;

subplot(4,1,4);
plot(T, demod_msg, 'g', 'LineWidth', 2);
ylim([-0.5 1.5]);
xlabel('Time (seconds)');
ylabel('Amplitude');
title('Demodulated Bit Stream');
grid on;

disp('Original Data:');
disp(data);

disp('Demodulated Data:');
disp(demod_bits);
